{
  "name": "qrferry",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "copy-wasm": "node scripts/copy-wasm.mjs",
    "predev": "npm run copy-wasm",
    "dev": "next dev",
    "prebuild": "npm run copy-wasm",
    "build": "next build",
    "start": "next start",
    "test": "npm run test:codec && npm run build && node --test tests/rendered-html.test.mjs",
    "test:codec": "node --import tsx --test tests/codec.test.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@raptorqr/core": "0.1.1",
    "@raptorqr/fast-qr-wasm": "0.1.1",
    "@raptorqr/raptorq-wasm": "0.1.1",
    "brotli-wasm": "3.0.1",
    "fflate": "^0.8.3",
    "next": "15.5.28",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zxing-wasm": "3.1.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "18.19.130",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.21",
    "eslint": "9.39.4",
    "eslint-config-next": "15.5.28",
    "postcss": "^8.5.6",
    "tailwindcss": "3.4.19",
    "tsx": "^4.23.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "overrides": {
    "@typescript-eslint/eslint-plugin": "8.55.0",
    "@typescript-eslint/parser": "8.55.0",
    "type-fest": "^4.41.0"
  }
